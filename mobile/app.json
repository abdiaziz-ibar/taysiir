{
  "expo": {
    "name": "Taysir Foundation",
    "slug": "taysir-foundation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1F3A5F",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F3A5F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taysirfoundation.app"
    },
    "android": {
      "package": "com.taysirfoundation.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F3A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Taysir Foundation wuxuu u baahan yahay galitaanka sawirrada si aad u soo gudbiso caddaynta lacag bixinta (invoice/screenshot)."
        }
      ],
      "expo-asset"
    ]
  }
}
