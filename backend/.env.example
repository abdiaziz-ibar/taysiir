# PostgreSQL connection string (Prisma format)
# Local:      postgresql://postgres:yourpassword@localhost:5432/school_fee_system?schema=public
# Neon:       postgresql://user:password@ep-xxxx.neon.tech/school_fee_system?sslmode=require
# Supabase:   postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
# Railway:    postgresql://postgres:password@containers-xxxx.railway.app:1234/railway
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/school_fee_system?schema=public

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=production

# CORS - your deployed frontend URL(s), comma separated
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Twilio WhatsApp (parent portal OTP) - https://console.twilio.com
# Sandbox for testing: From number is whatsapp:+14155238886, and each
# recipient must first WhatsApp "join <sandbox-word>" to that number once.
# For real users, requires a Twilio-approved WhatsApp Business sender.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
