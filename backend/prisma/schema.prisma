generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  fullName  String
  username  String    @unique
  email     String?
  password  String
  role      String    @default("staff") // "admin" | "staff"
  status    String    @default("active") // "active" | "inactive"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]

  @@map("users")
}

model Parent {
  id               String    @id @default(uuid())
  parentId         String    @unique // display code, e.g. P001
  fullName         String
  phone            String
  alternativePhone String?
  address          String?
  email            String?   @unique // optional contact info, unrelated to portal login
  notes            String?
  status           String    @default("active")
  password         String? // set once the parent creates their own portal password
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  fees             Fee[]
  payments         Payment[]
  tickets          PaymentTicket[]

  @@map("parents")
}

model AcademicYear {
  id         String    @id @default(uuid())
  name       String    @unique // e.g. "2025-2026"
  startYear  Int
  endYear    Int
  startMonth String    @default("September")
  endMonth   String    @default("August")
  isActive   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  fees       Fee[]
  payments   Payment[]

  @@map("academic_years")
}

model Fee {
  id             String   @id @default(uuid())
  parentId       String
  academicYearId String
  totalAmount    Float
  totalPaid      Float    @default(0)
  balance        Float    @default(0)
  status         String   @default("unpaid") // "paid" | "partial" | "unpaid"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent       Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([parentId, academicYearId])
  @@map("fees")
}

model Payment {
  id              String   @id @default(uuid())
  receiptNumber   String   @unique
  parentId        String
  academicYearId  String
  feeId           String
  amount          Float
  paymentDate     DateTime @default(now())
  paymentMethod   String // "Cash" | "Mobile Money" | "Bank" | "Other"
  referenceNumber String?
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent       Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  fee          Fee          @relation(fields: [feeId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tickets      PaymentTicket[]

  @@map("payments")
}

// A parent's report of a problem with one of their payments — e.g. "I paid
// but it's not showing" — with a proof-of-payment screenshot and a message
// thread so staff can go back and forth with the parent to resolve it.
model PaymentTicket {
  id            String   @id @default(uuid())
  parentId      String
  paymentId     String?
  screenshotUrl String?
  message       String
  status        String   @default("open") // "open" | "resolved"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent   Parent          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  payment  Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@map("payment_tickets")
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  senderType String // "parent" | "staff"
  senderName String
  message    String
  createdAt  DateTime @default(now())

  ticket PaymentTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}
