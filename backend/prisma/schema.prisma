generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  fullName  String
  username  String    @unique
  email     String?
  password  String
  role      String    @default("staff") // "admin" | "staff"
  status    String    @default("active") // "active" | "inactive"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]

  @@map("users")
}

model Parent {
  id               String    @id @default(uuid())
  parentId         String    @unique // display code, e.g. P001
  fullName         String
  phone            String
  alternativePhone String?
  address          String?
  email            String?   @unique // set once the parent links their portal account
  notes            String?
  status           String    @default("active")
  otpCode          String?
  otpExpiresAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  fees             Fee[]
  payments         Payment[]

  @@map("parents")
}

model AcademicYear {
  id         String    @id @default(uuid())
  name       String    @unique // e.g. "2025-2026"
  startYear  Int
  endYear    Int
  startMonth String    @default("September")
  endMonth   String    @default("August")
  isActive   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  fees       Fee[]
  payments   Payment[]

  @@map("academic_years")
}

model Fee {
  id             String   @id @default(uuid())
  parentId       String
  academicYearId String
  totalAmount    Float
  totalPaid      Float    @default(0)
  balance        Float    @default(0)
  status         String   @default("unpaid") // "paid" | "partial" | "unpaid"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent       Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([parentId, academicYearId])
  @@map("fees")
}

model Payment {
  id              String   @id @default(uuid())
  receiptNumber   String   @unique
  parentId        String
  academicYearId  String
  feeId           String
  amount          Float
  paymentDate     DateTime @default(now())
  paymentMethod   String // "Cash" | "Mobile Money" | "Bank" | "Other"
  referenceNumber String?
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent       Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  fee          Fee          @relation(fields: [feeId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("payments")
}
